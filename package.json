{
  "name": "@local/dsh-balance-panel",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-source balance and plan usage in the left sidebar, with DeepSeek peak/off-peak pricing and silent session refresh.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "main": "index.js",
  "author": {
    "name": "RedCarl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedCarl/dsh-balance-panel.git"
  },
  "homepage": "https://github.com/RedCarl/dsh-balance-panel",
  "bugs": {
    "url": "https://github.com/RedCarl/dsh-balance-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "balance",
    "usage",
    "opencode",
    "deepseek"
  ]
}
